*.log
*.str
vivado_*.backup.jou
vivado_*.backup.log
vivado_pid*.str
webtalk*.log
webtalk*.jou
webtalk_pa.xml

# Build outputs - regeneratable from create_project.tcl/build.tcl + RTL
*.bit
*.bit.bin
*.bin
*.dcp
*.rpt
*.ltx
*.wdb
*.pb

# GUI project mode's own project file (if you ever open a project
# via the wizard instead of scripting it - shouldn't normally appear
# given the workflow we've set up, but ignore defensively)
*.xpr

